{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xuanling://semantic-core/rebuild-manifest.schema.json",
  "title": "XuanLing Rebuild Manifest",
  "type": "object",
  "required": ["manifest_id", "subject_id", "last_valid_checkpoint", "accepted_ordered_deltas", "evidence_pointers", "holds", "invalidations", "rebuild_status"],
  "properties": {
    "manifest_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "last_valid_checkpoint": {"type": ["string", "null"]},
    "accepted_ordered_deltas": {"type": "array", "items": {"type": "string"}},
    "evidence_pointers": {"type": "array", "items": {"type": "string"}},
    "holds": {"type": "array", "items": {"type": "string"}},
    "invalidations": {"type": "array", "items": {"type": "string"}},
    "carrier_requirements": {"type": "array", "items": {"type": "string"}},
    "rebuild_status": {"enum": ["NOT_PROVEN", "PARTIALLY_PROVEN", "PROVEN_BOUNDED", "INVALID"]},
    "claim_ceiling": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
