{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xuanling://semantic-core/rebuild-manifest.schema.json",
  "title": "XuanLing Rebuild Manifest",
  "type": "object",
  "required": ["manifest_id", "subject_id", "last_valid_checkpoint", "accepted_ordered_deltas", "evidence_pointers", "external_native_source", "holds", "invalidations", "rebuild_status"],
  "properties": {
    "manifest_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "last_valid_checkpoint": {"type": ["string", "null"]},
    "accepted_ordered_deltas": {"type": "array", "items": {"type": "string"}},
    "evidence_pointers": {"type": "array", "items": {"type": "string"}},
    "external_native_source": {
      "type": "object",
      "required": ["binding_ref", "required", "resolution_scope", "public_pointer_disclosed", "receiver_readback"],
      "properties": {
        "binding_ref": {
          "type": "string",
          "pattern": "^XL-BINDING:[A-Z0-9-]+:[A-Z0-9-]+:R[0-9]+$"
        },
        "required": {"const": true},
        "resolution_scope": {"const": "AUTHORIZED_PRIVATE_CARRIER"},
        "public_pointer_disclosed": {"const": false},
        "receiver_readback": {"const": "UNPROVEN"}
      },
      "additionalProperties": false
    },
    "holds": {"type": "array", "items": {"type": "string"}},
    "invalidations": {"type": "array", "items": {"type": "string"}},
    "carrier_requirements": {"type": "array", "items": {"type": "string"}},
    "rebuild_status": {"enum": ["NOT_PROVEN", "PARTIALLY_PROVEN", "PROVEN_BOUNDED", "INVALID"]},
    "claim_ceiling": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
