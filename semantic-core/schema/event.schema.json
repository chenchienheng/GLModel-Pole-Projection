{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xuanling://semantic-core/event.schema.json",
  "title": "XuanLing Semantic Event",
  "type": "object",
  "required": ["event_id", "subject_id", "event_type", "occurred_at", "actor", "state_effect", "evidence"],
  "properties": {
    "event_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "event_type": {"enum": ["OBSERVATION", "ACTION", "RETURN", "ADMISSION", "RECONCILIATION", "INVALIDATION", "MIGRATION", "REENTRY", "FAILURE", "CAPABILITY_PROOF"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string"},
    "parent_event": {"type": ["string", "null"]},
    "correlation_id": {"type": ["string", "null"]},
    "state_effect": {
      "type": "object",
      "properties": {
        "before": {"type": ["string", "null"]},
        "after": {"type": ["string", "null"]},
        "material_delta": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "evidence": {"type": "array", "items": {"type": "string"}},
    "claim_ceiling": {"type": ["string", "null"]},
    "next_gate": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
